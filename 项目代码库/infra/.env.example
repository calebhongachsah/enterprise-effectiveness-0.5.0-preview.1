POSTGRES_DB=effectiveness
POSTGRES_USER=effectiveness
POSTGRES_PASSWORD=请替换为本机专用强密码
POSTGRES_PORT=5432
# 可选。使用已有的绝对目录作为 PostgreSQL 数据存储，否则使用 Compose 数据卷。
# POSTGRES_DATA_PATH=/absolute/path/to/postgres-data
# 下面两个地址使用同一组密码；建议密码只使用 URL 安全字符
DATABASE_URL=postgresql://effectiveness:请替换为本机专用强密码@127.0.0.1:5432/effectiveness
APP_DATABASE_URL=postgresql://effectiveness:请替换为本机专用强密码@postgres:5432/effectiveness
# 生成方式：openssl rand -base64 32。丢失后已保存的客户数据源密码将无法解密
DATA_SOURCE_MASTER_KEY=请替换为32字节随机密钥的Base64编码
# 空数据库创建首个管理员时使用。执行 openssl rand -hex 32 生成，初始化完成后从 .env 移除并重建应用容器。
ADMIN_BOOTSTRAP_TOKEN=
# 用户通过 HTTPS 访问时设为 true。仅本机 HTTP 初始化时使用 false。
SESSION_COOKIE_SECURE=false
PLATFORM_BIND_HOST=127.0.0.1
PLATFORM_PORT=8787
POSTGRES_POOL_SIZE=10
POSTGRES_CONNECT_TIMEOUT_MS=5000
BACKUP_RETENTION_COUNT=14
# 仅在服务端提供可信 CA 的正式环境设置为 require
POSTGRES_SSL=disable
